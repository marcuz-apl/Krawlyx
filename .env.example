# ==============================================================================
# Krawlyx Production Environment Configuration Template
# Copy this file to .env and customize for your deployment.
# ==============================================================================

# Application Security
MYKRAWL_SECRET_KEY=replace-with-a-cryptographically-secure-random-string-at-least-32-chars
MYKRAWL_COOKIE_SECURE=false # Set to true when serving behind HTTPS

# Initial Admin Bootstrap Credentials
MYKRAWL_ADMIN_USER=admin
MYKRAWL_ADMIN_PASSWORD=admin123

# Worker Pool & Concurrency
MYKRAWL_MAX_CONCURRENT_JOBS=4
MYKRAWL_MAX_PARALLEL_TARGETS_PER_JOB=10
MYKRAWL_DEFAULT_SPLIT_SIZE_MB=40

# Crawler Politeness & Safety Guardrails
MYKRAWL_ROBOTS_TXT_ENABLED=true
MYKRAWL_PER_DOMAIN_INTERVAL_S=1.0
MYKRAWL_SSRF_GUARD_ENABLED=true
MYKRAWL_CONTENT_SIZE_CAP_BYTES=5242880

# Optional: Admin Contact Email for User-Agent Header (NFR-05)
MYKRAWL_ADMIN_CONTACT_EMAIL=info@alfazen.org

# Optional: SSRF Allowed Hosts (comma-separated domain suffixes)
# MYKRAWL_SSRF_ALLOW_LIST=example.com,wikipedia.org
