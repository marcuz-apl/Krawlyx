# Copy to .env and fill in. All keys are prefixed MYKRAWL_.

# Session signing key — REQUIRED for any real deployment (generate: openssl rand -hex 32)
MYKRAWL_SECRET_KEY=

# Bootstrap admin — used only while the users table is empty
MYKRAWL_ADMIN_USER=admin
MYKRAWL_ADMIN_PASSWORD=

# Optional overrides
# MYKRAWL_DB_PATH=/absolute/path/to/mykrawl.db
# MYKRAWL_SESSION_TTL_S=43200
# MYKRAWL_COOKIE_SECURE=true   # enable when served over TLS

# M3 worker pool (PRD §6.2 FR-JOB-03, NFR-01)
# MYKRAWL_MAX_CONCURRENT_JOBS=2
# MYKRAWL_MAX_PARALLEL_TARGETS_PER_JOB=10
# M4 default export split size (PRD §6.4 FR-EXP-05)
# MYKRAWL_DEFAULT_SPLIT_SIZE_MB=40
# M5 global settings (PRD §6.5 FR-SET-02..04; consumed in M6)
# MYKRAWL_ROBOTS_TXT_ENABLED=true
# MYKRAWL_PER_DOMAIN_INTERVAL_S=1.0
# MYKRAWL_SSRF_GUARD_ENABLED=true
# MYKRAWL_CONTENT_SIZE_CAP_BYTES=5242880
# M6 — SSRF allow-list (comma-separated host suffixes)
# MYKRAWL_SSRF_ALLOW_LIST=internal.example.com,other.internal
# M6 — admin contact (appended to the User-Agent for NFR-05)
# MYKRAWL_ADMIN_CONTACT_EMAIL=ops@example.com

# Run `python -m app.core.doctor` to verify the env (Python, SQLite,
# DB write, log dir, registry).
