# Copy to .env and fill in. All keys are prefixed ZENCRAWL_.

# Session signing key — REQUIRED for any real deployment (generate: openssl rand -hex 32)
ZENCRAWL_SECRET_KEY=

# Bootstrap admin — used only while the users table is empty
ZENCRAWL_ADMIN_USER=admin
ZENCRAWL_ADMIN_PASSWORD=

# Optional overrides
# ZENCRAWL_DB_PATH=/absolute/path/to/zencrawl.db
# ZENCRAWL_SESSION_TTL_S=43200
# ZENCRAWL_COOKIE_SECURE=true   # enable when served over TLS

# M3 worker pool (PRD §6.2 FR-JOB-03, NFR-01)
# ZENCRAWL_MAX_CONCURRENT_JOBS=2
# ZENCRAWL_MAX_PARALLEL_TARGETS_PER_JOB=10
# M4 default export split size (PRD §6.4 FR-EXP-05)
# ZENCRAWL_DEFAULT_SPLIT_SIZE_MB=40
